# ── LLM (free tier, no card) ────────────────────────────────────────────
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model (openai/gpt-oss-120b). Groq
# periodically retires older models — check
# https://console.groq.com/docs/models for the current list if you ever
# get a "model_not_found" error.
# GROQ_MODEL=openai/gpt-oss-120b

# ── Flights (free, self-service, no card) ───────────────────────────────
# https://www.travelpayouts.com → sign up → Tools → API → copy your token
# (Note: Amadeus's free self-service tier was permanently shut down in
# July 2026 — this replaces it for flight price data.)
TRAVELPAYOUTS_TOKEN=your_travelpayouts_token_here

# ── Google Sign-In (free) ───────────────────────────────────────────────
# https://console.cloud.google.com  →  APIs & Services  →  Credentials
#   →  Create OAuth client ID  →  Web application
# Add http://localhost:5173 to "Authorized JavaScript origins"
GOOGLE_CLIENT_ID=your_google_client_id_here

# ── JWT session signing ─────────────────────────────────────────────────
# Any long random string — e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_random_secret

CORS_ORIGINS=http://localhost:5173
